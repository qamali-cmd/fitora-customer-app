{
  "expo": {
    "name": "Fitora Gear",
    "slug": "fitora-customer-app",
    "scheme": "fitoragear",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FC408C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitoragear.app"
    },
    "android": {
      "package": "com.fitoragear.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    }
  }
}